{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeClock",
  "version": "1.0.0",
  "identifier": "com.tongxiangjie.timeclock",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Time Clock",
        "url": "index.html",
        "width": 460,
        "height": 140,
        "minWidth": 230,
        "minHeight": 70,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
